# Copy this to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres connection string (Dashboard -> Connect -> "Prisma" or pooled connection string)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Random 32+ byte secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Telegram bot token (create via @BotFather on Telegram, "/newbot")
TELEGRAM_BOT_TOKEN="123456:ABC-placeholder-token"

# Telegram chat ID to send critical-alert notifications to
TELEGRAM_CHAT_ID="123456789"
