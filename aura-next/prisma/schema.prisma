generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  createdAt    DateTime @default(now())

  defaultPropertyId String?
  defaultProperty   Property? @relation(fields: [defaultPropertyId], references: [id])

  twoFactorEnabled   Boolean @default(true)
  criticalAlertsEmail Boolean @default(true)
  weeklyDigest       Boolean @default(false)

  propertyAccess UserProperty[]
}

model Property {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String
  shortName      String
  transactions   Transaction[]
  employees      Employee[]
  fraudCases     FraudCase[]
  riskScores     PropertyRiskScore[]
  alerts         Alert[]
  nightAuditRuns NightAuditRun[]
  users          User[]
  createdAt      DateTime            @default(now())

  userAccess UserProperty[]
}

// Which properties a user is permitted to see data for (transactions, employees,
// fraud cases, risk heatmap, alerts, night audit runs). A user with no rows here
// sees nothing for those screens — access is opt-in, not opt-out. Portfolio-wide
// entities (DashboardSnapshot, Insight, ReportDefinition, WeeklyFinancials) aren't
// scoped by this yet since they don't carry a propertyId in the schema.
model UserProperty {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

enum TransactionFlag {
  CLEARED
  FLAGGED
  REVIEW
}

model Transaction {
  id       String          @id @default(cuid())
  folioId  String
  postedAt DateTime
  type     String
  agent    String
  amount   Decimal         @db.Decimal(10, 2)
  flag     TransactionFlag @default(CLEARED)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([postedAt])
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

model Employee {
  id             String   @id @default(cuid())
  name           String
  role           String
  lastActivityAt DateTime
  riskScore      Int
  band           RiskBand

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
}

enum FraudSeverity {
  CRITICAL
  HIGH
  MEDIUM
}

enum FraudCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

model FraudCase {
  id         String          @id @default(cuid())
  severity   FraudSeverity
  pattern    String
  agent      String
  confidence Int
  amount     Decimal         @db.Decimal(10, 2)
  status     FraudCaseStatus @default(OPEN)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
}

// `amount` is the identified-leakage figure for this category; `recovered` is how
// much of it has actually been posted back to the ledger. Added 2026-08-03 (Wave 2)
// to replace the old fixed $71,340 total in /api/leakage with a real per-category
// recovery-tracking figure.
model LeakageCategory {
  id        String  @id @default(cuid())
  category  String
  amount    Decimal @db.Decimal(10, 2)
  recovered Decimal @db.Decimal(10, 2)
  pct       Int
  order     Int

  createdAt DateTime @default(now())
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id       String        @id @default(cuid())
  severity AlertSeverity
  title    String
  meta     String
  source   String
  status   AlertStatus   @default(OPEN)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
}

model NightAuditRun {
  id                   String   @id @default(cuid())
  date                 DateTime
  closeStepsCompleted  Int
  closeStepsTotal      Int
  openDiscrepancies    Int
  discrepancyAmount    Decimal  @db.Decimal(10, 2)
  revenuePosted        Decimal  @db.Decimal(10, 2)
  transactionCount     Int
  closeProgressPct     Int
  estCompletionLabel   String

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  checklist ChecklistItem[]

  createdAt DateTime @default(now())

  @@index([propertyId])
}

enum ChecklistStatus {
  DONE
  WARNING
  CRITICAL
  PENDING
}

model ChecklistItem {
  id     String          @id @default(cuid())
  label  String
  detail String?
  meta   String
  status ChecklistStatus
  order  Int

  nightAuditRunId String
  nightAuditRun   NightAuditRun @relation(fields: [nightAuditRunId], references: [id])

  @@index([nightAuditRunId])
}

model ReportDefinition {
  id               String @id @default(cuid())
  title            String
  description      String
  frequency        String
  lastUpdatedLabel String
  order            Int
}

enum InsightType {
  CRITICAL
  OPPORTUNITY
  TREND
}

model Insight {
  id   String      @id @default(cuid())
  type InsightType
  text String

  createdAt DateTime @default(now())
}

model PropertyRiskScore {
  id       String @id @default(cuid())
  dayIndex Int
  score    Float

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, dayIndex])
}

// Portfolio-wide KPI snapshot for the dashboard stat cards. In the target
// architecture these would be computed by an OLAP layer (ClickHouse) over
// the full transaction history, not derived from the small OLTP sample in
// this dev database — so for now this is a single seeded snapshot row
// rather than a live aggregate.
model DashboardSnapshot {
  id                        String   @id @default(cuid())
  portfolioRevenue          Decimal  @db.Decimal(12, 2)
  portfolioRevenueChangePct Float
  activeFraudAlerts         Int
  activeFraudAlertsCritical Int
  revenueLeakage            Decimal  @db.Decimal(12, 2)
  revenueLeakageRecovered   Decimal  @db.Decimal(12, 2)
  nightAuditPct             Float
  nightAuditExceptions      Int
  updatedAt                 DateTime @updatedAt
}

// Portfolio-wide weekly revenue vs. recovered-leakage trend backing the Dashboard's
// "Revenue vs. Recovered Leakage" chart. Wave 2 data-pipeline slice: replaces the
// hand-drawn illustrative SVG curve with a real (still portfolio-wide, not
// property-scoped) time series. Not derived from Transaction/LeakageCategory rows —
// there's no real weekly close process feeding this yet, so it's seeded historical
// data rather than a live rollup, same rationale as DashboardSnapshot above.
model WeeklyFinancials {
  id                String   @id @default(cuid())
  weekIndex         Int      @unique
  weekLabel         String
  revenue           Decimal  @db.Decimal(12, 2)
  leakageRecovered  Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
}
