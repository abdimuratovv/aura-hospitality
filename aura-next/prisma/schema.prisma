generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  createdAt    DateTime @default(now())

  defaultPropertyId String?
  defaultProperty   Property? @relation(fields: [defaultPropertyId], references: [id])

  twoFactorEnabled   Boolean @default(true)
  criticalAlertsEmail Boolean @default(true)
  weeklyDigest       Boolean @default(false)

  propertyAccess UserProperty[]
}

model Property {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String
  shortName      String
  transactions   Transaction[]
  employees      Employee[]
  fraudCases     FraudCase[]
  riskScores     PropertyRiskScore[]
  alerts         Alert[]
  nightAuditRuns NightAuditRun[]
  leakageCategories LeakageCategory[]
  weeklyFinancials  WeeklyFinancials[]
  users          User[]
  createdAt      DateTime            @default(now())

  userAccess UserProperty[]
}

// Which properties a user is permitted to see data for (transactions, employees,
// fraud cases, risk heatmap, alerts, night audit runs, leakage categories, weekly
// financials). A user with no rows here sees nothing for those screens — access is
// opt-in, not opt-out. Portfolio-wide entities (DashboardSnapshot's Portfolio
// Revenue card, Insight, ReportDefinition) aren't scoped by this yet since they
// don't carry a propertyId in the schema.
model UserProperty {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

enum TransactionFlag {
  CLEARED
  FLAGGED
  REVIEW
}

model Transaction {
  id       String          @id @default(cuid())
  folioId  String
  postedAt DateTime
  type     String
  agent    String
  amount   Decimal         @db.Decimal(10, 2)
  flag     TransactionFlag @default(CLEARED)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([postedAt])
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

model Employee {
  id             String   @id @default(cuid())
  name           String
  role           String
  lastActivityAt DateTime
  riskScore      Int
  band           RiskBand

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
}

enum FraudSeverity {
  CRITICAL
  HIGH
  MEDIUM
}

enum FraudCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

// SEEDED rows are the hand-authored illustrative cases from seed.mjs; DETECTED rows
// are written by the ai-service rule engine (added 2026-08-05, Wave 3) scanning
// Transaction rows for fraud patterns. ai-service deletes-then-recreates its own
// DETECTED rows on every run (mirrors seed.mjs's idempotency convention) and never
// touches SEEDED rows.
enum FraudCaseSource {
  SEEDED
  DETECTED
}

model FraudCase {
  id         String          @id @default(cuid())
  severity   FraudSeverity
  pattern    String
  agent      String
  confidence Int
  amount     Decimal         @db.Decimal(10, 2)
  status     FraudCaseStatus @default(OPEN)
  source     FraudCaseSource @default(SEEDED)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
}

// `amount` is the identified-leakage figure for this category; `recovered` is how
// much of it has actually been posted back to the ledger. Added 2026-08-03 (Wave 2)
// to replace the old fixed $71,340 total in /api/leakage with a real per-category
// recovery-tracking figure. Got a required `propertyId` 2026-08-04 (Wave 2) — each
// property has its own 5-category breakdown now instead of one portfolio-wide set.
model LeakageCategory {
  id        String  @id @default(cuid())
  category  String
  amount    Decimal @db.Decimal(10, 2)
  recovered Decimal @db.Decimal(10, 2)
  pct       Int
  order     Int

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id       String        @id @default(cuid())
  severity AlertSeverity
  title    String
  meta     String
  source   String
  status   AlertStatus   @default(OPEN)

  // Set by scripts/notifyCriticalAlerts.mjs once a Telegram notification has been
  // sent for this row (CRITICAL alerts only) — null means not yet notified. Added
  // 2026-08-05, Wave 3 Alert Engine slice.
  notifiedAt DateTime?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([propertyId])
}

model NightAuditRun {
  id                   String   @id @default(cuid())
  date                 DateTime
  closeStepsCompleted  Int
  closeStepsTotal      Int
  openDiscrepancies    Int
  discrepancyAmount    Decimal  @db.Decimal(10, 2)
  revenuePosted        Decimal  @db.Decimal(10, 2)
  transactionCount     Int
  closeProgressPct     Int
  estCompletionLabel   String

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  checklist ChecklistItem[]

  createdAt DateTime @default(now())

  @@index([propertyId])
}

enum ChecklistStatus {
  DONE
  WARNING
  CRITICAL
  PENDING
}

model ChecklistItem {
  id     String          @id @default(cuid())
  label  String
  detail String?
  meta   String
  status ChecklistStatus
  order  Int

  nightAuditRunId String
  nightAuditRun   NightAuditRun @relation(fields: [nightAuditRunId], references: [id])

  @@index([nightAuditRunId])
}

model ReportDefinition {
  id               String @id @default(cuid())
  title            String
  description      String
  frequency        String
  lastUpdatedLabel String
  order            Int
}

enum InsightType {
  CRITICAL
  OPPORTUNITY
  TREND
}

model Insight {
  id   String      @id @default(cuid())
  type InsightType
  text String

  createdAt DateTime @default(now())
}

model PropertyRiskScore {
  id       String @id @default(cuid())
  dayIndex Int
  score    Float

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, dayIndex])
}

// Portfolio-wide "Portfolio Revenue" stat card only, as of 2026-08-04. In the target
// architecture this would be computed by an OLAP layer (ClickHouse) over the full
// transaction history, not derived from the small (32-row) OLTP sample in this dev
// database — summing those would produce a number unrelated to real portfolio scale
// — so this one figure stays a seeded stand-in until that layer exists. The other
// three Dashboard stat cards (fraud alerts, revenue leakage, night audit) used to
// live here too but are now computed live from FraudCase/LeakageCategory/NightAuditRun
// in `/api/dashboard` — see that route.
model DashboardSnapshot {
  id                        String   @id @default(cuid())
  portfolioRevenue          Decimal  @db.Decimal(12, 2)
  portfolioRevenueChangePct Float
  updatedAt                 DateTime @updatedAt
}

// Weekly revenue vs. recovered-leakage trend backing the Dashboard's "Revenue vs.
// Recovered Leakage" chart. Wave 2 data-pipeline slice: replaces the hand-drawn
// illustrative SVG curve with a real time series. Not derived from
// Transaction/LeakageCategory rows — there's no real weekly close process feeding
// this yet, so it's seeded historical data rather than a live rollup, same
// rationale as DashboardSnapshot above. Got a required `propertyId` 2026-08-04
// (Wave 2) — each property has its own 12-week series now; `/api/dashboard` sums
// across the caller's accessible properties per weekIndex when more than one
// property is in scope (portfolio view), or returns a single property's series
// when narrowed via `?propertyId=`.
model WeeklyFinancials {
  id               String   @id @default(cuid())
  weekIndex        Int
  weekLabel        String
  revenue          Decimal  @db.Decimal(12, 2)
  leakageRecovered Decimal  @db.Decimal(12, 2)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([propertyId, weekIndex])
  @@index([propertyId])
}
